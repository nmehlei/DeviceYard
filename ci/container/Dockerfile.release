# syntax=docker/dockerfile:1
# Release image built from the smoke-tested native archive.
# Build context: a directory with runtime/ (extracted archive) and container/
# (entrypoint.sh, validate-config.cjs, notices.cjs, toolchain.json).
ARG EDITION=community
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS base
ARG TARGETARCH
RUN test "$TARGETARCH" = amd64

FROM base AS tooling
ARG EDITION
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip && rm -rf /var/lib/apt/lists/*
COPY container/toolchain.json /toolchain.json
RUN node -e 'const t=require("/toolchain.json");require("node:child_process").execFileSync("curl",["--fail","--location","--retry","3",t.maestro.url,"-o","/tmp/maestro.zip"],{stdio:"inherit"});const b=require("node:fs").readFileSync("/tmp/maestro.zip");if(require("node:crypto").createHash("sha256").update(b).digest("hex")!==t.maestro.sha256)throw Error("Maestro checksum mismatch")'
RUN unzip -q /tmp/maestro.zip -d /opt && chmod +x /opt/maestro/bin/maestro
# The Pro edition also ships the Maestro fork with --android-user support.
RUN mkdir -p /opt/maestro-android-user \
    && if [ "$EDITION" = pro ]; then \
      node -e 'const t=require("/toolchain.json").maestroFork;require("node:child_process").execFileSync("curl",["--fail","--location","--retry","3",t.url,"-o","/tmp/maestro-fork.zip"],{stdio:"inherit"});const b=require("node:fs").readFileSync("/tmp/maestro-fork.zip");if(require("node:crypto").createHash("sha256").update(b).digest("hex")!==t.sha256)throw Error("Maestro fork checksum mismatch")' \
      && unzip -q /tmp/maestro-fork.zip -d /tmp/maestro-fork \
      && cp -a /tmp/maestro-fork/*/. /opt/maestro-android-user/ \
      && chmod +x /opt/maestro-android-user/bin/maestro; \
    fi

FROM base AS common
RUN apt-get update && apt-get install -y --no-install-recommends adb openjdk-17-jre-headless ca-certificates tini tar \
    && rm -rf /var/lib/apt/lists/* \
    && usermod --login deviceyard --home /home/deviceyard node \
    && groupmod --new-name deviceyard node \
    && mkdir -p /data /home/deviceyard/.android /opt/deviceyard/notices \
    && chown -R 1000:1000 /data /home/deviceyard
ENV NODE_ENV=production HOME=/home/deviceyard DATA_DIR=/data PORT=8080 \
    PATH=/opt/maestro/bin:$PATH MAESTRO_CLI_NO_ANALYTICS=1 MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true
WORKDIR /opt/deviceyard
COPY runtime/ ./
COPY --from=tooling /opt/maestro /opt/maestro
COPY container/notices.cjs container/validate-config.cjs container/entrypoint.sh ./container/
COPY container/toolchain.json ./notices/toolchain.json
RUN node container/notices.cjs && chmod 755 container/entrypoint.sh

FROM common AS edition-community
ARG VERSION=unknown
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.title="DeviceYard Community" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.source="https://github.com/nmehlei/DeviceYard" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

FROM common AS edition-pro
ARG VERSION=unknown
ARG SOURCE_REVISION=unknown
COPY --from=tooling /opt/maestro-android-user /opt/maestro-android-user
ENV DEVICEYARD_ISOLATION_MAESTRO=/opt/maestro-android-user/bin/maestro
LABEL org.opencontainers.image.title="DeviceYard Pro" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.source="https://deviceyard.codebakery.net/pro/releases/" \
      org.opencontainers.image.licenses="LicenseRef-DeviceYard-Pro"

FROM edition-${EDITION} AS runtime
USER 1000:1000
RUN node --version && java -version && adb version && maestro --version \
    && rm -rf /home/deviceyard/.maestro
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e 'fetch("http://127.0.0.1:"+(process.env.PORT||8080)+"/login",{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))'
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/opt/deviceyard/container/entrypoint.sh"]
CMD ["node", "/opt/deviceyard/dist/index.js"]
