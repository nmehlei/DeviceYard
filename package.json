{
  "name": "deviceyard-runner",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "cli"
  ],
  "scripts": {
    "build": "node ci/build.cjs",
    "build:mcp": "esbuild src/mcp/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/src/mcp.mjs --define:__MCP_CLIENT_VERSION__=\"'0.0.0-dev'\" --define:__MCP_IS_BUNDLE__=true --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "test": "jest",
    "test:otel-smoke": "node scripts/otel-export-smoke.js",
    "start": "node dist/entry.js",
    "build:server": "tsc",
    "build:cli": "esbuild cli/src/main-entry.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/cli.cjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "app-binary-info": "^0.1.2",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swagger-ui-dist": "^5.32.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "openapi-types": "^12.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.2",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "AGPL-3.0-only"
}
